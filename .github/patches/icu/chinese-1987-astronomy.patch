 static void U_CALLCONV initAstronomerTimeZone() {
-    gAstronomerTimeZone = new SimpleTimeZone(CHINA_OFFSET, UNICODE_STRING_SIMPLE("CHINA_ZONE") );
+    // The astronomer approximation selects regular month 7 at the July 1987
+    // conjunction. Temporarily moving the calculation meridian one hour east
+    // selects leap month 6, matching the published calendar.
+    UErrorCode status = U_ZERO_ERROR;
+    const UDate millis1987[] = { static_cast<UDate>((1987 - 1970) * 365 * kOneDay + 4 * kOneDay) };
+    const UDate millis1988[] = { static_cast<UDate>((1988 - 1970) * 365 * kOneDay + 4 * kOneDay) };
+    LocalPointer<InitialTimeZoneRule> initialTimeZone(new InitialTimeZoneRule(
+        UNICODE_STRING_SIMPLE("GMT+8"), CHINA_OFFSET, 0), status);
+    LocalPointer<TimeZoneRule> rule1987(new TimeArrayTimeZoneRule(
+        UNICODE_STRING_SIMPLE("China 1987"), 9 * kOneHour, 0, millis1987, 1, DateTimeRule::STANDARD_TIME), status);
+    LocalPointer<TimeZoneRule> rule1988(new TimeArrayTimeZoneRule(
+        UNICODE_STRING_SIMPLE("China 1988"), CHINA_OFFSET, 0, millis1988, 1, DateTimeRule::STANDARD_TIME), status);
+    LocalPointer<RuleBasedTimeZone> zone(new RuleBasedTimeZone(
+        UNICODE_STRING_SIMPLE("CHINA_ZONE"), initialTimeZone.orphan()), status);
+    if (U_SUCCESS(status)) {
+        zone->addTransitionRule(rule1987.orphan(), status);
+        zone->addTransitionRule(rule1988.orphan(), status);
+        zone->complete(status);
+    }
+    if (U_SUCCESS(status))
+        gAstronomerTimeZone = zone.orphan();
+    else
+        gAstronomerTimeZone = new SimpleTimeZone(CHINA_OFFSET, UNICODE_STRING_SIMPLE("CHINA_ZONE"));
